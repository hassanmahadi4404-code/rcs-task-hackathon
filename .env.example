# Copy to .env.local. `npx supabase status -o env` prints the two Supabase
# values (API_URL and ANON_KEY) for your local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which evaluator lib/evaluate.ts uses: mock (default), gemini or fail.
EVALUATOR=mock
# Only for EVALUATOR=gemini. Free keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=
